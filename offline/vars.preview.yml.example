# Copy to vars.preview.yml (ignored) and use values from your target foundation.
backend-jar: ../build/clarity/release/rocky-backend.jar
frontend-dir: ../build/clarity/preview/frontend
backend-route: rocky-clarity-backend.apps.example.com
frontend-route: rocky-clarity-frontend.apps.example.com
stack: tanzucflinuxfs1
java-buildpack: java_buildpack_offline
staticfile-buildpack: staticfile_buildpack
backend-memory: 1500M
startup-timeout: 180
chat-timeout: 300s
chunk-size: 128
# Reusing these services shares users, documents, and model capacity with the original app.
# For data isolation, provision a separate pgvector database and set db-service accordingly.
db-service: rocky-db
chat-service: rocky-chat
embed-service: rocky-embed
