### Cloud Foundry ###
# Real service credentials for manifest.yml's ((var)) substitutions - see vars.yml.example for
# the expected shape. Never committed: these are live database/API credentials.
/vars.yml

# Site-specific values for offline/manifest.yml (no credentials, but specific to one foundation)
/offline/vars.yml

# Prepared offline artifacts are carried separately from source.
/offline/*.jar
/offline/frontend-dist.tar.gz
/offline/frontend-dist*/
/offline/backend-metadata.xml
/offline/SHA256SUMS
/offline/SOURCE-COMMIT.txt
/offline/vars.*.yml
